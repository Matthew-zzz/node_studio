[Unit]
Description=Activate verified node-studio.ru static releases
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
User=node-studio-deploy
Group=node-studio-deploy
Environment=HOME=/var/lib/node-studio-deploy
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/usr/bin/python3 /usr/local/lib/node-studio/deployment.py sync
TimeoutStartSec=300
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node-studio-deploy /var/www/node-studio.ru
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
