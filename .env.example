# Canonical origin for metadata, robots.txt and sitemap.xml.
SITE_ORIGIN=https://node-studio.ru

# Copy to .env for Docker. For local Docker login use http://localhost:3158.
# For a standalone development API use .env.portal and http://localhost:3000.
PORTAL_ORIGIN=https://node-studio.ru
HTTP_PORT=3158
BIND_ADDRESS=127.0.0.1
PORTAL_TRUST_PROXY=true
PORTAL_PORT=3158
PORTAL_DATABASE=.cache/portal/portal.sqlite
PORTAL_MOCK_PAYMENTS=true
# Keep false until deliberately testing real repository creation with mock payments.
PORTAL_MOCK_PROVISIONING=false
# Docker generates missing secrets in its persistent data volume on first start.
PORTAL_ENCRYPTION_KEY=
PORTAL_GITHUB_OWNER=Matthew-zzz
PORTAL_GITHUB_TOKEN=
PORTAL_GITHUB_WEBHOOK_SECRET=
PORTAL_TELEGRAM_TOKEN=
PORTAL_TELEGRAM_WEBHOOK_SECRET=
# Optional adapters. No service/model is selected or called without these settings.
PORTAL_OPENAI_KEY=
PORTAL_OPENAI_MODEL=
PORTAL_RESEND_KEY=
PORTAL_MAIL_FROM=
