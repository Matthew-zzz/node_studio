{
  "name": "nodo-studio-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/finalize-export.mjs",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node tests/export.test.mjs && node tests/payments.test.mjs",
    "test:payments": "node tests/payments.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "test:deploy": "python3 -B -m unittest discover -s tests/deploy -v",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@next/env": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "parse5": "8.0.1",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
