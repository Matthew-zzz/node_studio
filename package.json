{
  "name": "node-studio-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "assets:showcases": "node scripts/prepare-project-showcases.mjs",
    "assets:screenshots": "node scripts/prepare-project-screenshots.mjs",
    "assets:videos": "node scripts/prepare-site-videos.mjs",
    "build": "next build --webpack && node scripts/finalize-export.mjs",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node tests/export.test.mjs",
    "test:images": "node tests/project-images.test.mjs",
    "test:carousel": "node tests/carousel-autoplay.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@next/env": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "parse5": "8.0.1",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
